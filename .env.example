# Models and AI guidance live in ./config:
#   config/models/<name>.json  -> one tool per file, named after the slugified file name
#                                  shape: { "model": "<deployed id>", "description"?, "baseUrl"?, "apiKey"? }
#                                  baseUrl/apiKey fall back to the defaults below.
#                                  New/changed files are picked up per-request — no restart needed.
#   config/description.md      -> optional; served as MCP `instructions` to guide the calling AI.

# Optional default endpoint root for models without a baseUrl — any
# OpenAI-Responses-compatible endpoint (a LiteLLM proxy, Azure OpenAI/Foundry, etc.).
# The SDK appends /responses to this URL. Use the full API root:
#   OpenAI  -> https://api.openai.com/v1
#   Azure   -> https://<resource>.openai.azure.com/openai/v1
#   LiteLLM -> plain proxy root, e.g. http://localhost:4000
DEFAULT_BASE_URL=https://your-gateway.example.com

# Optional default API key for models without an apiKey. Kept server-side only.
DEFAULT_API_KEY=sk-your-key

# Boot even when no model files exist (default false — missing models are fatal).
# With true, the server starts with zero model tools; quorum and preset tools
# register but fail on use until a config/models/*.json appears (hot-reloaded).
# Meant for demos and registry sandboxes that only list tools.
# ALLOW_NO_MODELS=true

# Transport: http (default) or stdio. Desktop MCP clients set stdio.
# MCP_TRANSPORT=stdio

# HTTP transport bind address + port (ignored by stdio transport).
# Default 127.0.0.1 (localhost only). Set 0.0.0.0 to expose — then also set
# ALLOWED_HOSTS (comma-separated hostnames) for DNS-rebinding protection.
HOST=127.0.0.1
# ALLOWED_HOSTS=legion.example.com
PORT=5000

# Max discussion rounds the quorum tool will accept (default 5).
MAX_ROUNDS=5

# Per-model-call timeout in ms (default 90000). Caps one stalled seat so it
# cannot stall a whole council. The client retries once, so a seat's worst case
# is roughly double this before it is recorded as a failed turn.
MODEL_TIMEOUT=90000

# Optional default SOFT cumulative token budget for a whole quorum run. Sequential
# mode checks it between turns; parallel checks at round boundaries, so a round
# can overshoot before it trips (and synthesis still runs after). Not a hard cap.
# Once crossed, remaining turns are skipped. Unset = no limit. A per-call
# `tokenBudget` overrides this.
# TOKEN_BUDGET=100000

# Allow the calling AI to define ad-hoc quorum roles inline (default true).
# Set false to restrict roles to files in config/roles/.
DYNAMIC_ROLES=true

# Comma-separated allowlist of BUNDLED preset slugs to register as tools.
# Unset = every bundled preset. Set = only these, so a newly shipped bundled
# preset never appears on its own. Presets you add in your own config/presets/
# are always registered (authoring one is the opt-in); a local file that shares
# a bundled slug customizes that preset and still obeys this list.
# Every bundled preset, listed so you can delete the ones you don't want:
# PRESETS=battle_royale,brainstorm,bullying,code_review,courtroom,debate,double_blind,election,final_girl,focus_group,gauntlet,quick_take,refine,tiebreak,war_games,workshop

# Log level: debug | info | warn | error. Default: info.
LOG_LEVEL=info
